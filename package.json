{
  "name": "autojobs",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "pnpm --filter @autojobs/dashboard lint",
    "build": "pnpm --filter @autojobs/dashboard build && pnpm --filter @autojobs/worker build",
    "typecheck": "pnpm --filter @autojobs/dashboard typecheck && pnpm --filter @autojobs/worker typecheck",
    "dev:worker": "pnpm --filter @autojobs/worker dev",
    "deploy:worker": "pnpm exec wrangler deploy --config worker/wrangler.toml",
    "dev": "pnpm --filter @autojobs/dashboard dev",
    "deploy:pages": "pnpm build:dashboard:pages && cd apps/dashboard && pnpm exec wrangler pages deploy .vercel/output/static --project-name autojobs-dashboard --branch main --commit-dirty=true",
    "migrate:apply": "pnpm exec wrangler d1 migrations apply --config worker/wrangler.toml --database-name autojobs"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.0.0",
    "@playwright/test": "^1.52.0",
    "prettier": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "wrangler": "^4.95.0"
  }
}